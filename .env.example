# Quit Quest environment configuration.
#
# Copy to .env.local (web) or .env (Expo) and fill in. Never commit real
# files: .env and .env*.local are git-ignored. Every value below is public
# (it ships inside the app), but none is hardcoded so each build can differ.
#
# The web build reads NEXT_PUBLIC_QQ_* names. The mobile build reads the same
# names with an EXPO_PUBLIC_ prefix instead (EXPO_PUBLIC_QQ_REVENUECAT_IOS_KEY,
# and so on). lib/monetization/env.js reads both.

# --- Purchases (RevenueCat) ---------------------------------------------------
# Public SDK keys from RevenueCat > Project > API keys. Not secret, but they must
# come from here. The web build does not sell anything, so it ignores them.
NEXT_PUBLIC_QQ_REVENUECAT_IOS_KEY=appl_your_public_ios_sdk_key
NEXT_PUBLIC_QQ_REVENUECAT_ANDROID_KEY=goog_your_public_android_sdk_key

# --- Ads (AdMob, mobile apps only) ---------------------------------------------
# Master switch for banner ads. Premium always removes ads, whatever this says.
NEXT_PUBLIC_QQ_ADS_ENABLED=true
# Interstitials are built but off. Set to true only after reviewing the rules
# in lib/ads/policy.js (natural pauses, at most once per session).
NEXT_PUBLIC_QQ_INTERSTITIALS_ENABLED=false
# Production ad unit IDs from AdMob > Apps > Ad units. Development builds always
# use Google's published test units instead, so leave these empty locally.
NEXT_PUBLIC_QQ_ADMOB_IOS_BANNER_ID=
NEXT_PUBLIC_QQ_ADMOB_ANDROID_BANNER_ID=
NEXT_PUBLIC_QQ_ADMOB_IOS_INTERSTITIAL_ID=
NEXT_PUBLIC_QQ_ADMOB_ANDROID_INTERSTITIAL_ID=
# The AdMob APP IDs (ca-app-pub-...~...) go in the Expo app config
# (react-native-google-mobile-ads plugin), not here.

# --- Legal ---------------------------------------------------------------------
# Shown in Settings. Placeholders until the documents are hosted.
NEXT_PUBLIC_QQ_PRIVACY_POLICY_URL=https://example.com/quit-quest/privacy
NEXT_PUBLIC_QQ_TERMS_URL=https://example.com/quit-quest/terms

# --- Web site ---------------------------------------------------------------------
# The public address, used for share-image links. Optional on Vercel (it falls
# back to the deployment's own address). Example: https://quit-quest-game.vercel.app
NEXT_PUBLIC_QQ_SITE_URL=
# Search engines: unset or anything but 'true' = noindex (the pre-launch
# default). Set to 'true' at launch and redeploy.
NEXT_PUBLIC_QQ_ALLOW_INDEXING=

# --- Developer tools -------------------------------------------------------------
# The purchase mock and ad-slot outlines are on in `npm run dev` and on Vercel
# preview deployments, and always off in production. To force them on in a
# local production build: QQ_DEV_TOOLS=true npm run build
# QQ_DEV_TOOLS=true
# The /dev visual harness: on in dev and on previews; '1' forces it on elsewhere.
# Leave unset in production.
# NEXT_PUBLIC_ENABLE_DEV_HARNESS=1

# --- Set by the platform (do not add these yourself) --------------------------------
# NODE_ENV, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL
