    "autoprefixer": "^10.4.17",
    "next": "^14.2.0",
    "postcss": "^8.4.33",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.33",
    "pngjs": "7.0.0",
