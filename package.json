{
  "name": "quit-quest-rpg",
  "version": "1.0.0",
  "description": "Quit Quest - Stop Smoking RPG Game",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sprites:dev-test": "node scripts/sprites/generate-dev-test.js",
